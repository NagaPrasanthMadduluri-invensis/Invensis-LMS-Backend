# ── Production .env for EC2 ──────────────────────────────
# Copy to .env on the instance and fill in real values.
# Never commit the real .env (it is gitignored).

NODE_ENV=production
PORT=5000                       # internal port; ALB/nginx forwards 443 -> 5000

# ── Database — AWS RDS PostgreSQL 18 ─────────────────────
# URL-encode special chars in the password (@ -> %40, # -> %23, etc.)
# SSL is controlled by DB_SSL below — do NOT also put sslmode in this URL.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@your-db.abc123.ap-south-1.rds.amazonaws.com:5432/tms_lms

# disable | require | no-verify  (RDS: use no-verify, or require + NODE_EXTRA_CA_CERTS)
DB_SSL=no-verify

# ── Secrets — generate ON the box: openssl rand -hex 32 (run for each) ──
JWT_ACCESS_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARS
# Shared with the CRM; it HMAC-signs POST /api/orders with this
ORDER_HMAC_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHARS
# Placeholder password for learner accounts auto-created from CRM orders
DEFAULT_PARTICIPANT_PASSWORD=Welcome@123
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Frontend origin + refresh cookie ─────────────────────
# Exact scheme+host of the deployed frontend, no trailing slash.
CORS_ORIGIN=https://lms.yourdomain.com

# Cross-site frontend<->API (different parent domains): none + secure.
# If they share a parent domain (app.x.com + api.x.com), use lax instead.
COOKIE_SAMESITE=none
COOKIE_SECURE=true
