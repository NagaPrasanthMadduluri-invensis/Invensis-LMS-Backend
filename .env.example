NODE_ENV=development
PORT=5000

# PostgreSQL 18 — uuidv7() is used for primary keys
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tms_lms

# Use long random strings in real environments
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
# Shared secret the CRM uses to HMAC-sign POST /api/orders requests
ORDER_HMAC_SECRET=change-me-order-hmac-secret-min-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CORS_ORIGIN=http://localhost:3000

# Refresh-token cookie. Cross-site (prod) needs SAMESITE=none + SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
